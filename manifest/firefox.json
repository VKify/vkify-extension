{
  "browser_specific_settings": {
    "gecko": {
      "id": "vkify@vkify.ru",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; form-action 'none'"
  }
}
