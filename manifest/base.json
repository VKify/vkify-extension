{
  "manifest_version": 3,
  "name": "VKify",
  "version": "1.7.0",
  "description": "Улучшенный интерфейс и функциональность для VK",
  "author": "VKify Team",
  "homepage_url": "https://vkify.ru/",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "300": "icons/icon300.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "downloads"
  ],

  "host_permissions": [
    "https://*.vk.com/*",
    "https://*.vk.ru/*",
    "https://vkvideo.ru/*",
    "https://api.vk.com/*",
    "https://api.vk.ru/*",
    "https://vkify.ru/*",
    "https://*.userapi.com/*",
    "https://*.vkuseraudio.net/*",
    "https://genius.com/*",
    "https://*.genius.com/*"
  ],

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "300": "icons/icon300.png"
    },
    "default_title": "VKify - Настройки"
  },

  "content_scripts": [
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*",
        "https://vkvideo.ru/*"
      ],
      "js": ["content.js"],
      "css": [
        "styles/content.css",
        "styles/features.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vkify.ru/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": ["embed.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },

  "commands": {
    "media_play_pause":    { "description": "VKify · Воспроизвести / Пауза"  },
    "media_next":          { "description": "VKify · Следующий трек"         },
    "media_prev":          { "description": "VKify · Предыдущий трек"        },
    "media_seek_forward":  { "description": "VKify · Перемотка вперёд"       },
    "media_seek_backward": { "description": "VKify · Перемотка назад"        },
    "media_rate_up":       { "description": "VKify · Скорость +0.25×"        },
    "media_rate_down":     { "description": "VKify · Скорость −0.25×"        },
    "media_rate_reset":    { "description": "VKify · Скорость 1.0×"          }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "injected/*.js"
      ],
      "matches": [
        "https://*.vk.com/*",
        "https://*.vk.ru/*",
        "https://vkvideo.ru/*"
      ]
    },
    {
      "resources": [
        "index.html",
        "assets/*"
      ],
      "matches": [
        "https://*.vk.com/*",
        "https://*.vk.ru/*"
      ]
    }
  ]
}
