{
  "manifest_version": 3,
  "name": "VKify",
  "version": "1.7.1",
  "default_locale": "ru",
  "description": "__MSG_appDescription__",
  "author": "VKify Team",
  "homepage_url": "https://vkify.ru/",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "300": "icons/icon300.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "downloads",
    "scripting"
  ],

  "host_permissions": [
    "https://*.vk.ru/*",
    "https://vkvideo.ru/*",
    "https://*.vkvideo.ru/*",
    "https://api.vk.ru/*",
    "https://vkify.ru/*",
    "https://*.userapi.com/*",
    "https://*.vkuseraudio.net/*",
    "https://*.mycdn.me/*",
    "https://genius.com/*",
    "https://*.genius.com/*"
  ],

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "300": "icons/icon300.png"
    },
    "default_title": "__MSG_actionTitle__"
  },

  "content_scripts": [
    {
      "matches": [
        "https://vk.ru/*",
        "https://*.vk.ru/*",
        "https://vkvideo.ru/*",
        "https://*.vkvideo.ru/*"
      ],
      "js": ["content.js"],
      "css": [
        "styles/content.css",
        "styles/features.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vkify.ru/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": ["embed.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },

  "commands": {
    "media_play_pause":    { "description": "__MSG_cmdPlayPause__"    },
    "media_next":          { "description": "__MSG_cmdNext__"         },
    "media_prev":          { "description": "__MSG_cmdPrev__"         },
    "media_seek_forward":  { "description": "__MSG_cmdSeekForward__"  },
    "media_seek_backward": { "description": "__MSG_cmdSeekBackward__" },
    "media_rate_up":       { "description": "__MSG_cmdRateUp__"       },
    "media_rate_down":     { "description": "__MSG_cmdRateDown__"     },
    "media_rate_reset":    { "description": "__MSG_cmdRateReset__"    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "injected/*.js"
      ],
      "matches": [
        "https://*.vk.ru/*",
        "https://vkvideo.ru/*",
        "https://*.vkvideo.ru/*"
      ]
    },
    {
      "resources": [
        "index.html",
        "assets/*",
        "locales/*"
      ],
      "matches": [
        "https://*.vk.ru/*"
      ]
    }
  ]
}
