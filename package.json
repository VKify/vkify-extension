{
  "name": "vkify-extension",
  "version": "1.4.0",
  "description": "VKify - Улучшения для ВКонтакте",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && node scripts/build.mjs --all",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "build:opera": "node scripts/build.mjs --browser=opera",
    "build:fast": "node scripts/build.mjs --browser=chrome",
    "build:dev": "node scripts/build.mjs --dev --browser=chrome",
    "lint:firefox": "web-ext lint -s dist/firefox",
    "run:firefox": "web-ext run -s dist/firefox",
    "package:chrome": "npm run build:chrome && web-ext build -s dist/chrome -a dist/packages --filename vkify-chrome.zip --overwrite-dest",
    "package:firefox": "npm run build:firefox && web-ext build -s dist/firefox -a dist/packages --filename vkify-firefox.zip --overwrite-dest",
    "package:opera": "npm run build:opera && web-ext build -s dist/opera -a dist/packages --filename vkify-opera.zip --overwrite-dest",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vite": "^5.1.4",
    "vitest": "^4.1.5",
    "web-ext": "^8.3.0"
  }
}